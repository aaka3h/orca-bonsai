# Copy to config.env, then replace these with absolute paths.
# This is a local shell configuration file; only source configuration you trust.
ORCA_SERVER_BIN="/absolute/path/to/llama-server"
ORCA_MODEL="/absolute/path/to/model.gguf"
# Optional adapter for a compatible base model. Leave empty for the base model.
ORCA_LORA=""
